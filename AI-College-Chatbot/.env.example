# Copy this file to .env and edit the values before running the project.

# Flask secret key - used to sign session cookies and CSRF tokens
SECRET_KEY=change-this-to-a-random-secret-key

# Default admin account created by scripts/seed_database.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# SQLite database location (default is fine for local development)
DATABASE_URL=sqlite:///database/college.db

# Minimum cosine-similarity score (0-1) required before the chatbot
# will trust a match. Lower = more lenient, Higher = more strict.
SIMILARITY_THRESHOLD=0.20
